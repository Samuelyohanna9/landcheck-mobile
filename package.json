{
  "name": "landcheck-mobile",
  "version": "1.0.43",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "android:native": "expo run:android",
    "android:version:bump": "node scripts/bump-android-version.js",
    "android:apk:release:raw": "node scripts/build-android-release.js assembleRelease",
    "android:bundle:release:raw": "node scripts/build-android-release.js bundleRelease",
    "android:release:artifacts:raw": "node scripts/build-android-release.js assembleRelease bundleRelease",
    "android:release:artifacts": "npm run android:version:bump && npm run android:release:artifacts:raw",
    "android:bundle:release": "npm run android:version:bump && npm run android:bundle:release:raw",
    "ios:native": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "ios:build:preview": "npx eas-cli build --platform ios --profile preview",
    "ios:build:production": "npx eas-cli build --platform ios --profile production",
    "ios:submit:production": "npx eas-cli submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.15.7",
    "@react-navigation/native": "^7.2.0",
    "@react-navigation/native-stack": "^7.14.7",
    "@rnmapbox/maps": "^10.3.0",
    "axios": "^1.13.6",
    "expo": "~55.0.26",
    "expo-application": "~55.0.15",
    "expo-av": "^16.0.8",
    "expo-background-task": "~55.0.18",
    "expo-file-system": "~55.0.22",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-location": "~55.1.10",
    "expo-network": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-secure-store": "~55.0.14",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
